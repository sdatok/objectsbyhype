# Neon Postgres - get from neon.tech dashboard
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob: copy from Vercel → Project → Storage (or Env Vars). Required to serve
# /api/media/blob/* URLs locally when using a DB that points at prod uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional dev-only: if you omit BLOB_READ_WRITE_TOKEN locally, set this to your deployed
# site origin (no trailing slash). Image requests will redirect to prod’s blob proxy.
# DEV_MEDIA_PROXY_BASE_URL="https://your-app.vercel.app"

# Admin credentials
ADMIN_PASSWORD="your-secure-password-here"

# Session secret - generate with: openssl rand -base64 32
SESSION_SECRET="your-random-32-char-secret-here"

# Site URL for Stripe redirects (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: welcome discount percent for signed-in first order (default 10)
# WELCOME_DISCOUNT_PERCENT="10"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# /survivor (50-player shooter)
# Shared between Vercel and the Railway game server. Generate with:
#   openssl rand -base64 32
# The exact same value MUST be set on Railway (SURVIVOR_SECRET).
SURVIVOR_SECRET="your-random-32-char-survivor-secret"
# Public WebSocket URL of the Colyseus server on Railway. Browser uses this.
# Example: wss://survivor-production.up.railway.app  (or your custom subdomain)
NEXT_PUBLIC_SURVIVOR_WS_URL="ws://localhost:2567"
# HTTP base URL Vercel uses to talk to the Railway server's /admin endpoints.
# Usually same host as above but with https:// instead of wss://.
SURVIVOR_GAME_SERVER_URL="http://localhost:2567"
# Active fighter cap (default 50). Set on Vercel + Railway; must match on both.
SURVIVOR_MAX_PLAYERS=50
NEXT_PUBLIC_SURVIVOR_MAX_PLAYERS=50
