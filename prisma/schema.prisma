generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  brand       String
  description String             @db.Text
  price       Decimal            @db.Decimal(10, 2)
  category    String
  status      ProductStatus      @default(DRAFT)
  sizes       String[]
  sizePricing Json?
  /// Legacy aggregate; sum of sizeStocks + variant stocks is authoritative for inventory
  quantity    Int                @default(0)
  consignment Boolean            @default(false)
  /// When true, PDP shows a "Hand made to order" identifier so buyers know
  /// the item is crafted after purchase rather than shipped from stock.
  madeToOrder Boolean            @default(false)
  /// Drop-shipping: link to the Etsy listing we re-order from when this sells.
  /// Admin-only — never surfaced on the storefront.
  etsyUrl     String?
  /// Etsy seller/shop name for quick reference (admin-only).
  etsyShop    String?
  /// Our buy price on Etsy in USD (admin-only, used for margin display).
  etsyCost    Decimal?           @db.Decimal(10, 2)
  /// Text to paste into the Etsy listing's personalization/notes field when
  /// re-ordering (e.g. color/size/variant text). Admin-only.
  etsyNote    String?            @db.Text
  images      ProductImage[]
  sizeStocks  ProductSizeStock[]
  variants    ProductVariant[]
  lineItems   OrderLineItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
  @@index([category])
}

/// Optional color variants of a product. A product with zero variants behaves
/// exactly as before (uses Product.images, Product.sizeStocks, Product.price).
/// A product with one or more variants supersedes those for display: PDP shows
/// a swatch row and the selected variant's images/sizes/stock/price.
model ProductVariant {
  id           String                    @id @default(cuid())
  productId    String
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName    String
  /// Hex color (e.g. "#ECE5D4") used for the storefront swatch. Optional — falls back to a labeled chip.
  colorHex     String?
  /// Optional price override; null = use product.price
  price        Decimal?                  @db.Decimal(10, 2)
  displayOrder Int                       @default(0)
  /// Per-variant Etsy link override (different color often = different Etsy
  /// listing). Falls back to Product.etsyUrl when null. Admin-only.
  etsyUrl      String?
  /// Per-variant Etsy cost override; null = inherit Product.etsyCost.
  etsyCost     Decimal?                  @db.Decimal(10, 2)
  /// Per-variant note to paste at Etsy checkout; null = inherit Product.etsyNote.
  etsyNote     String?                   @db.Text
  images       ProductVariantImage[]
  sizeStocks   ProductVariantSizeStock[]
  lineItems    OrderLineItem[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([productId, colorName])
  @@index([productId])
}

model ProductVariantImage {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url          String
  displayOrder Int            @default(0)

  @@index([variantId])
}

model ProductVariantSizeStock {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int            @default(0)

  @@unique([variantId, size])
  @@index([variantId])
}

model ProductSizeStock {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int     @default(0)

  @@unique([productId, size])
  @@index([productId])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  displayOrder Int     @default(0)

  @@index([productId])
}

model WtfImage {
  id           String   @id @default(cuid())
  url          String
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([displayOrder])
  @@index([featured])
}

model CustomerProfile {
  clerkUserId         String   @id
  email               String
  welcomeDiscountUsed Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  type             PromoType
  /// PERCENT: 0–100 whole order; FIXED: USD off order subtotal
  value            Decimal     @db.Decimal(10, 2)
  active           Boolean     @default(true)
  expiresAt        DateTime?
  maxRedemptions   Int?
  perCustomerLimit Int?
  minSubtotal      Decimal?    @db.Decimal(10, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orders           Order[]
}

model Order {
  id                     String          @id @default(cuid())
  status                 OrderStatus     @default(PENDING)
  subtotal               Decimal         @db.Decimal(10, 2)
  discountTotal          Decimal         @default(0) @db.Decimal(10, 2)
  total                  Decimal         @db.Decimal(10, 2)
  email                  String?
  stripeSessionId        String?         @unique
  stripePaymentIntentId  String?         @unique
  clerkUserId            String?
  supplierOrderReference String?
  supplierOrderedAt      DateTime?
  supplierShippedAt      DateTime?
  deliveredAt            DateTime?
  shippingCarrier        String?
  trackingNumber         String?
  fulfillmentNotes       String?         @db.Text
  /// Snapshot of the buyer's shipping address (and name/phone) captured from
  /// Stripe Checkout at payment time. Used in admin fulfillment to copy/paste
  /// into Etsy when drop-shipping.
  shippingAddress        Json?
  welcomeDiscountApplied Boolean         @default(false)
  promoCodeId            String?
  promo                  PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  lineItems              OrderLineItem[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([clerkUserId])
}

model OrderLineItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Color variant (null when the product has no variants)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Snapshot of the color name at purchase time (preserved even if variant is deleted)
  variantLabel String?
  size         String
  quantity     Int
  unitPrice    Decimal         @db.Decimal(10, 2)
  name         String
  brand        String

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Submission {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String?
  itemName     String
  brand        String
  description  String           @db.Text
  askingPrice  Decimal?         @db.Decimal(10, 2)
  condition    String
  imageUrls    String[]
  status       SubmissionStatus @default(PENDING)
  adminNotes   String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

enum PromoType {
  PERCENT
  FIXED
}

enum SubmissionStatus {
  PENDING
  REVIEWING
  ACCEPTED_BUY
  ACCEPTED_CONSIGN
  DECLINED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SUPPLIER_ORDERED
  SUPPLIER_SHIPPED
  DELIVERED
  CANCELLED
}

/// Singleton row (id="default") that holds the home-page mini-game's settings
/// and the current giveaway window. Edited from /admin/game.
model GameConfig {
  id                String   @id @default("default")
  /// Master on/off switch for the home-page game.
  enabled           Boolean  @default(true)
  /// Visible prize title (e.g. "10% off any rug").
  prizeTitle        String   @default("OBH Mystery Prize")
  /// Optional longer description rendered under the title.
  prizeDescription  String?  @db.Text
  /// Length of each giveaway window in hours. Used to compute endsAt = windowStartedAt + windowHours.
  windowHours       Int      @default(1)
  /// When the current window started. Scores submitted between windowStartedAt and windowStartedAt + windowHours compete.
  windowStartedAt   DateTime @default(now())
  /// Game tuning. Higher = faster task spawns, smaller = easier.
  gameSpeed         Float    @default(1.0)
  /// Number of misses before game over (3 = arcade-classic, lower = harder).
  maxMisses         Int      @default(3)
  /// Initial seconds each task gives the player; difficulty scales these down over time.
  taskBaseSeconds   Int      @default(6)
  updatedAt         DateTime @updatedAt
}

/// One submitted high score. Players enter their email to be eligible for the
/// giveaway; the highest score per window wins that window's prize.
model GameScore {
  id              String   @id @default(cuid())
  email           String
  /// Optional display name / initials. Falls back to the email handle.
  displayName     String?
  score           Int
  /// Seconds the player survived (used as a tiebreaker; lower = won the score faster).
  secondsPlayed   Int      @default(0)
  /// Denormalized window-start timestamp the score belongs to. Lets us bucket
  /// scores into windows without a join even after admin rolls the window.
  windowStartedAt DateTime
  createdAt       DateTime @default(now())

  @@index([windowStartedAt, score])
  @@index([email])
}

/// Lightweight, self-hosted page-view counter used by the admin stats page.
/// One row per storefront page hit; aggregations are computed at read time.
/// Admin and API routes are intentionally excluded.
model PageView {
  id        String   @id @default(cuid())
  /// Pathname only (e.g. "/" or "/product/foo"). Query strings are stripped.
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

/// Anti-cheat session for the home-page mini-game. Issued by /api/game/start
/// and consumed exactly once by /api/game/scores. The signature column lets
/// the server verify the client didn't tamper with the issued-at timestamp,
/// and usedAt enforces single-use so the same session can't submit twice.
model GameSession {
  id        String    @id @default(cuid())
  /// HMAC over `${id}:${issuedAt.getTime()}` using SESSION_SECRET. Server
  /// re-derives this on submit and compares constant-time.
  signature String
  issuedAt  DateTime  @default(now())
  /// Set once when the score is successfully submitted. Re-submits 409.
  usedAt    DateTime?
  /// Best-effort source IP (forwarded-for / x-real-ip) for abuse triage.
  ip        String?

  @@index([issuedAt])
  @@index([usedAt])
}
