generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  brand       String
  description String             @db.Text
  price       Decimal            @db.Decimal(10, 2)
  category    String
  status      ProductStatus      @default(DRAFT)
  sizes       String[]
  sizePricing Json?
  /// Legacy aggregate; sum of sizeStocks + variant stocks is authoritative for inventory
  quantity    Int                @default(0)
  consignment Boolean            @default(false)
  /// When true, PDP shows a "Hand made to order" identifier so buyers know
  /// the item is crafted after purchase rather than shipped from stock.
  madeToOrder Boolean            @default(false)
  /// Drop-shipping: link to the Etsy listing we re-order from when this sells.
  /// Admin-only — never surfaced on the storefront.
  etsyUrl     String?
  /// Etsy seller/shop name for quick reference (admin-only).
  etsyShop    String?
  /// Our buy price on Etsy in USD (admin-only, used for margin display).
  etsyCost    Decimal?           @db.Decimal(10, 2)
  /// Text to paste into the Etsy listing's personalization/notes field when
  /// re-ordering (e.g. color/size/variant text). Admin-only.
  etsyNote    String?            @db.Text
  images      ProductImage[]
  sizeStocks  ProductSizeStock[]
  variants    ProductVariant[]
  lineItems   OrderLineItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
  @@index([category])
}

/// Optional color variants of a product. A product with zero variants behaves
/// exactly as before (uses Product.images, Product.sizeStocks, Product.price).
/// A product with one or more variants supersedes those for display: PDP shows
/// a swatch row and the selected variant's images/sizes/stock/price.
model ProductVariant {
  id           String                    @id @default(cuid())
  productId    String
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName    String
  /// Hex color (e.g. "#ECE5D4") used for the storefront swatch. Optional — falls back to a labeled chip.
  colorHex     String?
  /// Optional price override; null = use product.price
  price        Decimal?                  @db.Decimal(10, 2)
  displayOrder Int                       @default(0)
  /// Per-variant Etsy link override (different color often = different Etsy
  /// listing). Falls back to Product.etsyUrl when null. Admin-only.
  etsyUrl      String?
  /// Per-variant Etsy cost override; null = inherit Product.etsyCost.
  etsyCost     Decimal?                  @db.Decimal(10, 2)
  /// Per-variant note to paste at Etsy checkout; null = inherit Product.etsyNote.
  etsyNote     String?                   @db.Text
  images       ProductVariantImage[]
  sizeStocks   ProductVariantSizeStock[]
  lineItems    OrderLineItem[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([productId, colorName])
  @@index([productId])
}

model ProductVariantImage {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url          String
  displayOrder Int            @default(0)

  @@index([variantId])
}

model ProductVariantSizeStock {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int            @default(0)

  @@unique([variantId, size])
  @@index([variantId])
}

model ProductSizeStock {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int     @default(0)

  @@unique([productId, size])
  @@index([productId])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  displayOrder Int     @default(0)

  @@index([productId])
}

model WtfImage {
  id           String   @id @default(cuid())
  url          String
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([displayOrder])
  @@index([featured])
}

model CustomerProfile {
  clerkUserId         String   @id
  email               String
  welcomeDiscountUsed Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  type             PromoType
  /// PERCENT: 0–100 whole order; FIXED: USD off order subtotal
  value            Decimal     @db.Decimal(10, 2)
  active           Boolean     @default(true)
  expiresAt        DateTime?
  maxRedemptions   Int?
  perCustomerLimit Int?
  minSubtotal      Decimal?    @db.Decimal(10, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orders           Order[]
}

model Order {
  id                     String          @id @default(cuid())
  status                 OrderStatus     @default(PENDING)
  subtotal               Decimal         @db.Decimal(10, 2)
  discountTotal          Decimal         @default(0) @db.Decimal(10, 2)
  total                  Decimal         @db.Decimal(10, 2)
  email                  String?
  stripeSessionId        String?         @unique
  stripePaymentIntentId  String?         @unique
  clerkUserId            String?
  supplierOrderReference String?
  supplierOrderedAt      DateTime?
  supplierShippedAt      DateTime?
  deliveredAt            DateTime?
  shippingCarrier        String?
  trackingNumber         String?
  fulfillmentNotes       String?         @db.Text
  /// Snapshot of the buyer's shipping address (and name/phone) captured from
  /// Stripe Checkout at payment time. Used in admin fulfillment to copy/paste
  /// into Etsy when drop-shipping.
  shippingAddress        Json?
  welcomeDiscountApplied Boolean         @default(false)
  promoCodeId            String?
  promo                  PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  lineItems              OrderLineItem[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([clerkUserId])
}

model OrderLineItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Color variant (null when the product has no variants)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Snapshot of the color name at purchase time (preserved even if variant is deleted)
  variantLabel String?
  size         String
  quantity     Int
  unitPrice    Decimal         @db.Decimal(10, 2)
  name         String
  brand        String

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Submission {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String?
  itemName     String
  brand        String
  description  String           @db.Text
  askingPrice  Decimal?         @db.Decimal(10, 2)
  condition    String
  imageUrls    String[]
  status       SubmissionStatus @default(PENDING)
  adminNotes   String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

enum PromoType {
  PERCENT
  FIXED
}

enum SubmissionStatus {
  PENDING
  REVIEWING
  ACCEPTED_BUY
  ACCEPTED_CONSIGN
  DECLINED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SUPPLIER_ORDERED
  SUPPLIER_SHIPPED
  DELIVERED
  CANCELLED
}

/// Singleton row (id="default") that holds the home-page mini-game's settings
/// and the current giveaway window. Edited from /admin/game.
model GameConfig {
  id                String   @id @default("default")
  /// Master on/off switch for the home-page game.
  enabled           Boolean  @default(true)
  /// Visible prize title (e.g. "10% off any rug").
  prizeTitle        String   @default("OBH Mystery Prize")
  /// Optional longer description rendered under the title.
  prizeDescription  String?  @db.Text
  /// Length of each giveaway window in hours. Used to compute endsAt = windowStartedAt + windowHours.
  windowHours       Int      @default(1)
  /// When the current window started. Scores submitted between windowStartedAt and windowStartedAt + windowHours compete.
  windowStartedAt   DateTime @default(now())
  /// Game tuning. Higher = faster task spawns, smaller = easier.
  gameSpeed         Float    @default(1.0)
  /// Number of misses before game over (3 = arcade-classic, lower = harder).
  maxMisses         Int      @default(3)
  /// Initial seconds each task gives the player; difficulty scales these down over time.
  taskBaseSeconds   Int      @default(6)
  updatedAt         DateTime @updatedAt
}

/// One submitted high score. Players enter their email to be eligible for the
/// giveaway; the highest score per window wins that window's prize.
model GameScore {
  id              String   @id @default(cuid())
  email           String
  /// Optional display name / initials. Falls back to the email handle.
  displayName     String?
  score           Int
  /// Seconds the player survived (used as a tiebreaker; lower = won the score faster).
  secondsPlayed   Int      @default(0)
  /// Denormalized window-start timestamp the score belongs to. Lets us bucket
  /// scores into windows without a join even after admin rolls the window.
  windowStartedAt DateTime
  createdAt       DateTime @default(now())

  @@index([windowStartedAt, score])
  @@index([email])
}

/// Lightweight, self-hosted page-view counter used by the admin stats page.
/// One row per storefront page hit; aggregations are computed at read time.
/// Admin and API routes are intentionally excluded.
model PageView {
  id        String   @id @default(cuid())
  /// Pathname only (e.g. "/" or "/product/foo"). Query strings are stripped.
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

/// Anti-cheat session for the home-page mini-game. Issued by /api/game/start
/// and consumed exactly once by /api/game/scores. The signature column lets
/// the server verify the client didn't tamper with the issued-at timestamp,
/// and usedAt enforces single-use so the same session can't submit twice.
model GameSession {
  id        String    @id @default(cuid())
  /// HMAC over `${id}:${issuedAt.getTime()}` using SESSION_SECRET. Server
  /// re-derives this on submit and compares constant-time.
  signature String
  issuedAt  DateTime  @default(now())
  /// Set once when the score is successfully submitted. Re-submits 409.
  usedAt    DateTime?
  /// Best-effort source IP (forwarded-for / x-real-ip) for abuse triage.
  ip        String?

  @@index([issuedAt])
  @@index([usedAt])
}

/// Singleton row (id="default") holding settings for the /survivor 50-player
/// shooter. Edited from /admin/survivor. Match lifecycle itself lives in the
/// authoritative Colyseus server; this model just stores what the lobby/admin
/// UI needs.
model SurvivorConfig {
  id               String   @id @default("default")
  /// Master on/off switch for the /survivor route.
  enabled          Boolean  @default(true)
  /// Visible prize for the upcoming/current match.
  prizeTitle       String   @default("OBH Survivor Prize")
  prizeDescription String?  @db.Text
  /// Match length in seconds (default 7 minutes).
  matchSeconds     Int      @default(420)
  /// The match currently considered "live" or "waiting" by the lobby. Cleared
  /// when the game server posts the end webhook. Used so multiple lobby
  /// visitors all get the same matchToken bucket.
  currentMatchId   String?
  updatedAt        DateTime @updatedAt
}

/// One match. Created when an admin clicks "Start match" from /admin/survivor;
/// status transitions WAITING -> PLAYING -> ENDED. Players themselves live in
/// SurvivorParticipant.
model SurvivorMatch {
  id           String                 @id @default(cuid())
  status       SurvivorMatchStatus    @default(WAITING)
  prizeTitle   String
  startedAt    DateTime?
  endedAt      DateTime?
  /// Email of the winning player (denormalized for quick admin lookups).
  winnerEmail  String?
  participants SurvivorParticipant[]
  createdAt    DateTime               @default(now())

  @@index([status])
  @@index([createdAt])
}

enum SurvivorMatchStatus {
  WAITING
  PLAYING
  ENDED
}

/// One participant in a match. Email + displayName are captured in the lobby
/// before the player joins the game server. Placement / kills / survival are
/// filled in by the game server's end-of-match webhook.
model SurvivorParticipant {
  id              String        @id @default(cuid())
  matchId         String
  match           SurvivorMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  email           String
  displayName     String
  /// Final placement (1 = winner, ...). Null until the match ends or if the
  /// player joined the lobby but never connected to the game server.
  placement       Int?
  kills           Int           @default(0)
  /// Seconds the player stayed alive in the match (capped at match length).
  survivedSeconds Int           @default(0)
  joinedAt        DateTime      @default(now())
  disconnectedAt  DateTime?

  @@unique([matchId, email])
  @@index([matchId])
  @@index([email])
}

// ---------- Escape Luna (run from the dog) ----------

model EscapeLunaConfig {
  id               String   @id @default("default")
  enabled          Boolean  @default(false)
  prizeTitle       String   @default("Escape Luna Prize")
  prizeDescription String?  @db.Text
  matchSeconds     Int      @default(420)
  currentMatchId   String?
  updatedAt        DateTime @updatedAt
}

model EscapeLunaMatch {
  id           String              @id @default(cuid())
  status       SurvivorMatchStatus @default(WAITING)
  prizeTitle   String
  startedAt    DateTime?
  endedAt      DateTime?
  winnerEmail  String?
  participants EscapeLunaParticipant[]
  createdAt    DateTime            @default(now())

  @@index([status])
  @@index([createdAt])
}

model EscapeLunaParticipant {
  id              String          @id @default(cuid())
  matchId         String
  match           EscapeLunaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  email           String
  displayName     String
  placement       Int?
  survivedSeconds Int             @default(0)
  joinedAt        DateTime        @default(now())
  disconnectedAt  DateTime?

  @@unique([matchId, email])
  @@index([matchId])
  @@index([email])
}

// ---------- Wheel of Hype (pro-member monthly spin) ----------

enum WheelPrizeTier {
  COMMON
  RARE
  JACKPOT
}

/// Singleton row (id="default") for /wheelofhype settings.
model WheelConfig {
  id             String   @id @default("default")
  enabled        Boolean  @default(true)
  commonWeight   Int      @default(60)
  rareWeight     Int      @default(30)
  jackpotWeight  Int      @default(10)
  updatedAt      DateTime @updatedAt
}

/// Pro membership tracked manually in admin (MRR reporting).
model WheelProMember {
  id           String          @id @default(cuid())
  name         String
  email        String          @default("")
  monthlyPrice Decimal         @db.Decimal(10, 2)
  active       Boolean         @default(true)
  notes        String?         @db.Text
  codes        WheelPlayCode[]
  spins        WheelSpin[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([email])
  @@index([active])
}

model WheelPrize {
  id                String         @id @default(cuid())
  label             String
  tier              WheelPrizeTier
  quantityInitial   Int            @default(1)
  quantityRemaining Int            @default(1)
  sortOrder         Int            @default(0)
  active            Boolean        @default(true)
  spins             WheelSpin[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tier, active])
  @@index([sortOrder])
}

/// One unique play code per pro member per calendar month (YYYY-MM).
model WheelPlayCode {
  id          String         @id @default(cuid())
  code        String         @unique
  proMemberId String
  proMember   WheelProMember @relation(fields: [proMemberId], references: [id], onDelete: Cascade)
  monthKey    String
  usedAt      DateTime?
  spin        WheelSpin?
  createdAt   DateTime       @default(now())

  @@unique([proMemberId, monthKey])
  @@index([monthKey])
  @@index([usedAt])
}

model WheelSpin {
  id          String         @id @default(cuid())
  codeId      String         @unique
  code        WheelPlayCode  @relation(fields: [codeId], references: [id], onDelete: Cascade)
  proMemberId String
  proMember   WheelProMember @relation(fields: [proMemberId], references: [id], onDelete: Cascade)
  prizeId     String
  prize       WheelPrize     @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  prizeLabel  String
  tier        WheelPrizeTier
  monthKey    String
  ip          String?
  createdAt   DateTime       @default(now())

  @@index([monthKey])
  @@index([proMemberId])
  @@index([createdAt])
}

// ---------- Giveaway Wheel (game-winner single spin) ----------

/// Singleton row (id="default") for /giveawaywheel settings.
model GiveawayWheelConfig {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  commonWeight   Int      @default(60)
  rareWeight     Int      @default(30)
  jackpotWeight  Int      @default(10)
  updatedAt      DateTime @updatedAt
}

model GiveawayWheelPrize {
  id                String              @id @default(cuid())
  label             String
  tier              WheelPrizeTier
  quantityInitial   Int                 @default(1)
  quantityRemaining Int                 @default(1)
  sortOrder         Int                 @default(0)
  active            Boolean             @default(true)
  spins             GiveawayWheelSpin[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tier, active])
  @@index([sortOrder])
}

/// One-time play code issued when a player wins a game.
model GiveawayWheelPlayCode {
  id          String             @id @default(cuid())
  code        String             @unique
  winnerName  String
  winnerEmail String             @default("")
  source      String             @default("")
  notes       String?            @db.Text
  usedAt      DateTime?
  spin        GiveawayWheelSpin?
  createdAt   DateTime           @default(now())

  @@index([usedAt])
  @@index([winnerEmail])
  @@index([createdAt])
}

model GiveawayWheelSpin {
  id          String                @id @default(cuid())
  codeId      String                @unique
  code        GiveawayWheelPlayCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  prizeId     String
  prize       GiveawayWheelPrize    @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  prizeLabel  String
  tier        WheelPrizeTier
  winnerName  String
  winnerEmail String                @default("")
  ip          String?
  createdAt   DateTime              @default(now())

  @@index([createdAt])
  @@index([winnerEmail])
}
