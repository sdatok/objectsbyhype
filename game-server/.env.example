# Required: shared HMAC secret. MUST match Vercel's SURVIVOR_SECRET.
SURVIVOR_SECRET="your-random-32-char-survivor-secret"

# Required: where the server POSTs the match-result webhook.
# Local dev: http://localhost:3000/api/admin/survivor/result
# Production: https://objectsbyhype.com/api/admin/survivor/result
WEBHOOK_URL="http://localhost:3000/api/admin/survivor/result"

# Optional: CORS origin allowed for /admin/* HTTP calls. Default "*".
# Production should set this to the public site origin only.
# ALLOWED_ORIGIN="https://objectsbyhype.com"

# Port the WS + HTTP server listens on. Railway sets PORT automatically.
PORT=2567

# Player caps (default 100). Must match Vercel env vars.
SURVIVOR_MAX_PLAYERS=100
LUNA_MAX_PLAYERS=100
RED_LIGHT_MAX_PLAYERS=100
